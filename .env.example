# --- secrets (required) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-output-of-openssl-rand-hex-32

# --- deployment ---
# Public domain the app is served from. Used by Traefik for TLS routing
# and by the API for CORS. Change to your own domain before deploying.
DOMAIN=sub.yourdomain.com
# Public subdomain for the API. Mobile apps and CLI tools hit this directly.
# Defaults to api.${DOMAIN} if not set.
# API_DOMAIN=api.sub.yourdomain.com

# --- data directory ---
# Root for all persistent data. SQLite DBs live at DATA_DIR/identity.db and DATA_DIR/tenant_*.db,
# backups at DATA_DIR/backups/, future uploads at DATA_DIR/uploaded/<user_id>/.
# Inside Docker this is always /data (mapped to ./data by docker-compose).
# On the host set this to your absolute path to the ./data folder.
# DATA_DIR=/absolute/path/to/data

# --- database configuration ---
# Choose "sqlite" or "postgres"
DATABASE_TYPE=sqlite

# --- auth / JWT ---
JWT_EXPIRE_MIN=14400
JWT_ISSUER=gps-tracker
JWT_AUDIENCE=gps-tracker-web
# Optional dedicated pepper for public share-link token hashing.
# If empty, JWT_SECRET is used.
# SHARE_TOKEN_PEPPER=replace-me-with-random-32+-char-string

# Cookie flags: in production keep both as below (Traefik terminates TLS).
AUTH_COOKIE_SECURE=true
# Set to true for plain-HTTP local dev (no TLS): cookies will not get Secure flag.
DEV_INSECURE_COOKIES=false

# --- API server ---
# Bind address and port (used when running uvicorn directly or in compose).
API_HOST=0.0.0.0
API_PORT=8765

# CORS origins the API allows. Defaults to https://${DOMAIN} in compose.
# Override if you need additional origins (e.g., a separate admin dashboard).
# CORS_ORIGINS=https://${DOMAIN}

# Set to true only when you need to inspect /docs, /redoc, /openapi.json.
# Defaults to false in compose to keep the prod attack surface small.
DOCS_ENABLED=false

# Logging level for API and ingest containers. Use DEBUG to see per-endpoint logs.
# LOG_LEVEL=INFO

# Enable colored human-readable console logs instead of structured JSON lines (useful for local terminal reading)
# DEV_LOGS=true

# Keep exception stack traces extremely compact and readable (on by default)
# COMPACT_EXCEPTIONS=true

# --- backup ---
# Backups always go to DATA_DIR/backups/ (hourly/ daily/ weekly/ subdirs).
# Set DATA_DIR above. No BACKUP_DIR needed unless you want a different location.
# BACKUP_DIR=/absolute/path/to/backups

# --- ingest servers ---
# INGEST_HOST: bind address for ingest servers. 0.0.0.0 works everywhere.
# INGEST_HOST=0.0.0.0
INGEST_CODEC8_PORT=5027
INGEST_OSMAND_PORT=8766

# --- frontend / nginx ---
# Host port for the nginx/frontend container. Access at http://localhost:8080
# FRONTEND_PORT=8080

# Where the web (nginx) container forwards /api/ requests.
# Defaults to "api:8765" (docker service). Override for host-mode backend.
# API_UPSTREAM=host.docker.internal:8765

# Vite dev server (`npm run dev`) proxy target. Used only outside compose.
VITE_API_TARGET=http://127.0.0.1:8765
