FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy packages first
COPY packages/core ./packages/core

# Copy apps/ingest/requirements.txt and install (which references packages/core)
COPY apps/ingest/requirements.txt ./apps/ingest/requirements.txt
WORKDIR /app/apps/ingest
RUN pip install --no-cache-dir -r requirements.txt

# Copy rest of the ingest code
COPY apps/ingest/ingest ./ingest

EXPOSE 5027 8766

CMD ["python", "-m", "ingest.ingest"]
